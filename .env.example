# Kopier denne filen til .env for lokal utvikling (netlify dev).
# I produksjon settes disse i Netlify: Site settings → Environment variables.

# Fra Supabase-prosjektet: Project Settings → API
SUPABASE_URL=https://DITT-PROSJEKT.supabase.co

# anon/public-nøkkelen — samme verdi som limes inn i public/index.html.
# Brukes av netlify/functions/add-sources.js (kjører DB-kall SOM den innloggede
# brukeren, ikke med utvidede rettigheter — derfor holder anon-nøkkelen her).
SUPABASE_ANON_KEY=fyll-inn-anon-key

# service_role-nøkkelen — KUN til bruk i netlify/functions/rss-poll.js (server-side,
# ingen innlogget bruker å knytte kallet til). Skal ALDRI limes inn i
# public/index.html eller committes til Git.
SUPABASE_SERVICE_ROLE_KEY=fyll-inn-service-role-key
