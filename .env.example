# Kopier denne filen til .env for lokal utvikling (netlify dev).
# I produksjon settes disse i Netlify: Site settings → Environment variables.

# Fra Supabase-prosjektet: Project Settings → API
SUPABASE_URL=https://DITT-PROSJEKT.supabase.co

# Valgfritt, KUN lokalt — direkte database-tilkobling, brukt av
# `npm run db:migrate` (scripts/run-schema.js) for å kjøre supabase/schema.sql
# rett mot databasen i stedet for å lime det inn i Supabase sin SQL Editor
# manuelt. IKKE en Netlify-miljøvariabel, og IKKE nødvendig for at selve
# appen skal virke — bare en snarvei for den som vedlikeholder databasen.
# Hentes fra Supabase: prosjektet → "Connect"-knappen øverst → "URI" under
# Connection string → trykk "Reveal"/"Reset database password" for passordet.
SUPABASE_DB_URL=postgresql://postgres.DITT-PROSJEKT:PASSORD@aws-x-region.pooler.supabase.com:5432/postgres

# anon/public-nøkkelen — samme verdi som limes inn i public/index.html.
# Brukes av netlify/functions/add-sources.js (kjører DB-kall SOM den innloggede
# brukeren, ikke med utvidede rettigheter — derfor holder anon-nøkkelen her).
SUPABASE_ANON_KEY=fyll-inn-anon-key

# service_role-nøkkelen — KUN til bruk i netlify/functions/rss-poll.js (server-side,
# ingen innlogget bruker å knytte kallet til). Skal ALDRI limes inn i
# public/index.html eller committes til Git.
SUPABASE_SERVICE_ROLE_KEY=fyll-inn-service-role-key

# OpenAI — AI-vurdering, manusgenerering, relevansfilter og AI-assistenten.
OPENAI_API_KEY=fyll-inn-openai-key

# WordPress — for "Publiser til WordPress (utkast)". Ett sett per nettsted;
# du trenger kun å fylle inn settet for nettstedet(ene) dere faktisk bruker
# funksjonen på. *_APP_PASSWORD er et WordPress Application Password
# (Brukere → Din profil → Application Passwords i wp-admin for riktig
# nettsted), IKKE hovedpassordet. Opprett gjerne egne, separate passord for
# denne appen (ikke gjenbruk de som allerede er satt opp for "WordPress
# Infosak Batch Administrator") — enklere å tilbakekalle ett uten å påvirke
# resten.

WP_UASNORWAY_URL=https://www.uasnorway.no
WP_UASNORWAY_USERNAME=fyll-inn-wp-brukernavn
WP_UASNORWAY_APP_PASSWORD=fyll-inn-application-password

WP_DRONEMAG_URL=https://www.dronemag.no
WP_DRONEMAG_USERNAME=fyll-inn-wp-brukernavn
WP_DRONEMAG_APP_PASSWORD=fyll-inn-application-password

# Valgfritt overstyring — dronemag.no bruker AUTOMATISK de samme ACF-
# feltnøklene som uasnorway.no som standard (bekreftet av brukeren 28.08.2026
# at oppsettet er identisk), så disse trenger normalt IKKE fylles ut. Sett
# dem KUN hvis feltene faktisk viser seg å ikke stemme i praksis — se README,
# avsnittet om dronemag.no. Er ÉN av dem satt, overstyres standarden i sin
# helhet.
WP_DRONEMAG_ACF_IMAGE=
WP_DRONEMAG_ACF_IMAGE_TXT=
WP_DRONEMAG_ACF_PHOTO_CREDITS=
WP_DRONEMAG_ACF_BYLINE=
WP_DRONEMAG_ACF_EXCERPT=
WP_DRONEMAG_ACF_CONTENT=
